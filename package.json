{
  "name": "image-ar-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "overrides": {
    "tar": "7.5.22"
  },
  "scripts": {
    "dev:player": "npm run dev --workspace @image-ar/player",
    "dev:studio": "npm run dev --workspace @image-ar/studio",
    "dev:spike:png": "npm run dev --workspace @image-ar/spike-mindar-png",
    "dev:spike:gif": "npm run dev --workspace @image-ar/spike-mindar-gif",
    "build": "npm run build --workspaces --if-present",
    "build:pages": "npm run build && node scripts/assemble-pages.mjs",
    "fixtures:player": "node scripts/generate-player-demo.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "content:import": "node scripts/import-experience.mjs",
    "content:validate": "node scripts/validate-experiences.mjs",
    "content:index": "node scripts/generate-experience-index.mjs"
  }
}
